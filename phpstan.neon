# The shared config of netresearch/typo3-ci-workflows sets level 10,
# treatPhpDocTypesAsCertain, the strictness flags and the excludePaths;
# phpstan/extension-installer registers phpstan-phpunit, phpstan-typo3 and the
# other PHPStan extensions. Build/phpstan-shared.php includes it only where the
# package is installed, see the comment there.
includes:
    - Build/phpstan-shared.php

parameters:
    paths:
        - Classes
        - Configuration
    excludePaths:
        - Resources/Private/Libs
    # TYPO3 creates the authentication service through the DI container
    # (public in Configuration/Services.yaml), which passes its dependencies
    # to the inject*() methods instead of the constructor.
    additionalConstructors:
        - Netresearch\NrSamlAuth\Sv\AuthenticationService::injectSettingsRepository
        - Netresearch\NrSamlAuth\Sv\AuthenticationService::injectSamlService
        - Netresearch\NrSamlAuth\Sv\AuthenticationService::injectConnectionPool
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # TYPO3 13+ attribute not available in TYPO3 12 - listeners registered via Services.yaml
        - '#Attribute class TYPO3\\CMS\\Core\\Attribute\\AsEventListener does not exist#'
        # TYPO3 specific patterns
        - '#Access to an undefined property TYPO3\\CMS\\Core\\Authentication\\AbstractUserAuthentication::\$#'
        # onelogin/php-saml library patterns
        - '#Parameter .* of class OneLogin\\Saml2\\#'
        # storeSessionData() exists on FrontendUserAuthentication but not on AbstractUserAuthentication
        - '#Call to an undefined method TYPO3\\CMS\\Core\\Authentication\\AbstractUserAuthentication::storeSessionData\(\)#'
        # Extbase Repository generic types
        - '#extends generic class TYPO3\\CMS\\Extbase\\Persistence\\Repository but does not specify its types#'
        # Request body can be array or object
        - '#Cannot access offset .* on array\|object#'
        # Property never read warnings for DI
        - '#is never read, only written#'
        # Array value types - relaxed for legacy compatibility
        - '#no value type specified in iterable type array#'
    tmpDir: .Build/cache/phpstan
