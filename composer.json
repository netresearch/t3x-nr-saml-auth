{
    "name": "netresearch/nr-saml-auth",
    "description": "SAML Frontend Authentication - Single sign-on (SSO) for frontend users via SAML.",
    "type": "typo3-cms-extension",
    "homepage": "https://netresearch.de",
    "license": "GPL-2.0-or-later",
    "prefer-stable": true,
    "minimum-stability": "dev",
    "keywords": [
        "TYPO3",
        "extension",
        "saml",
        "authentication",
        "sso",
        "single-sign-on"
    ],
    "authors": [
        {
            "name": "Torsten Fink",
            "email": "torsten.fink@netresearch.de",
            "role": "Developer"
        },
        {
            "name": "Tobias Hein",
            "email": "tobias.hein@netresearch.de",
            "role": "Developer"
        },
        {
            "name": "Christopher Rath",
            "email": "christopher.rath@netresearch.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/netresearch/t3x-nr-saml-auth/issues",
        "source": "https://github.com/netresearch/t3x-nr-saml-auth"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3/cms-extbase": "^13.4 || ^14.3",
        "onelogin/php-saml": "^4.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "netresearch/typo3-ci-workflows": "^2.0.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.2.5 || ^12.1.2 || ^13.0.2",
        "saschaegerer/phpstan-typo3": "^2.0 || ^3.0",
        "typo3/cms-install": "^13.4 || ^14.3",
        "typo3/coding-standards": "^0.8 || ^0.9",
        "typo3/testing-framework": "^9.0.2"
    },
    "autoload": {
        "psr-4": {
            "Netresearch\\NrSamlAuth\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netresearch\\NrSamlAuth\\Tests\\": "Tests/"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "a9f/fractor-extension-installer": true,
            "captainhook/hook-installer": true,
            "infection/extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "ci": [
            "@ci:test:php:cgl",
            "@ci:test:php:phpstan",
            "@ci:test:php:rector",
            "@ci:test:php:unit",
            "@ci:test:php:functional"
        ],
        "ci:cgl": "php-cs-fixer fix --config .php-cs-fixer.php",
        "ci:rector": "rector process --config Build/rector.php",
        "ci:test:php:cgl": "php-cs-fixer fix --config .php-cs-fixer.php --dry-run --diff",
        "ci:test:php:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "ci:test:php:phpstan": "phpstan analyse -c phpstan.neon",
        "ci:test:php:phpstan:baseline": "phpstan analyse -c phpstan.neon --generate-baseline",
        "ci:test:php:rector": "rector process --config Build/rector.php --dry-run",
        "ci:test:php:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "docs:clean": "rm -rf Documentation-GENERATED-temp",
        "docs:render": "docker run --rm -v $(pwd):/project -t ghcr.io/typo3-documentation/render-guides:latest --config Documentation"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "nr_saml_auth",
            "web-dir": ".Build/public"
        },
        "branch-alias": {
            "dev-main": "13.0.x-dev"
        }
    }
}
